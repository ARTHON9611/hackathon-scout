# Copy to .env for local runs (never commit .env)
SPREADSHEET_ID=your_google_sheet_id_here
# Either a path to service_account.json OR the raw JSON string (CI uses the JSON string)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Dry run skips Sheets push, writes data/ + summaries locally
DRY_RUN=false
# Comma-separated seed URLs for DoraHacks (used if list discovery yields 0)
DORAHACKS_SEED_URLS=
